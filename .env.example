# Copy to .env.local for local development. Never commit real values.
# On the host (e.g. Vercel), set these under Project Settings → Environment Variables.

# The Custom webhook address from the Make.com scenario (see docs/MAKE-SETUP.md).
# Leave empty locally: inquiries are then written to .data/dev-inquiries.jsonl instead.
MAKE_WEBHOOK_URL=

# A long random string. Must match the value in the scenario's filter.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MAKE_WEBHOOK_SECRET=

# Local testing only, when MAKE_WEBHOOK_URL is empty:
#   fail = simulate Make.com being down (shows the error message)
#   slow = 3 second delay (shows the loading state)
# MOCK_MAKE=

# Preview deploys only: allow a production build while site.config.ts still
# has sample content. Never set this on the live site.
# ALLOW_SAMPLE_CONTENT=1

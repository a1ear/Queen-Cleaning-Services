# Copy to .env.local for local development. Never commit real values.
# `npx convex dev` fills in the first three automatically.

# Convex deployment used by `npx convex dev`.
CONVEX_DEPLOYMENT=
# Public URL of the Convex deployment (the browser connects here for the admin panel).
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Lets the website's server save inquiries. Must match the Convex env var of the same name.
# scripts/setup-convex-env.mjs creates it and writes it here.
INQUIRY_SUBMIT_SECRET=

# Vercel only:
# CONVEX_DEPLOY_KEY=          production deploy key from the Convex dashboard
# ALLOW_SAMPLE_CONTENT=1      preview builds while site.config.ts has sample content
